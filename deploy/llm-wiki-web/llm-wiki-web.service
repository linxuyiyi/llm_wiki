[Unit]
Description=LLM Wiki Web Edition
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=llmwiki
Group=llmwiki
WorkingDirectory=/opt/llm-wiki-web
Environment=LLM_WIKI_DATA_DIR=/var/lib/llm-wiki
Environment=LLM_WIKI_WEB_HOST=0.0.0.0
Environment=LLM_WIKI_WEB_PORT=8080
ExecStart=/opt/llm-wiki-web/start.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/llm-wiki

[Install]
WantedBy=multi-user.target
